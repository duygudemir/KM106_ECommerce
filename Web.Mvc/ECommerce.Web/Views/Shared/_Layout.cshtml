<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerce.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerce.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ECommerce</a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Product" asp-action="Index">Ürünler</a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("buyer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Cart" asp-action="Index">Sepet</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Order" asp-action="MyOrders">Siparişlerim</a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("seller"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Product" asp-action="MyProducts">Ürünlerim</a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Profile" asp-action="Index">Profile</a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning"
                               href="https://localhost:7083/"
                               target="_blank">
                                Admin Panel
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Profile" asp-action="Index">
                                @User.Identity.Name
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Account" asp-action="Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="border-top mt-5 py-3">
        <div class="container">
            <small>© @DateTime.Now.Year - ECommerce.Web</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
