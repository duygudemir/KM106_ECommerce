@model List<App.Data.Entities.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<h1>Ürünler</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Kategori</th>
            <th>Satıcı</th>
            <th>İşlemler</th>
            <th>Sepet</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@(p.Category != null ? p.Category.Name : "-")</td>
                <td>@(p.Seller != null ? p.Seller.FirstName + " " + p.Seller.LastName : "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-primary">
                        Detay
                    </a>
                </td>
                <td>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("buyer"))
                        {
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@p.Id" class="btn btn-primary btn-sm">
                                Sepete Ekle
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm">
                                Müşteri hesabınızla giriş yapınız
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm">
                            Sepete eklemek için giriş yap
                        </a>
                    }

                </td>

            </tr>
        }
    </tbody>
</table>
