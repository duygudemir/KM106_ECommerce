@model List<App.Data.Entities.Product>

@{
    ViewData["Title"] = "Ürünlerim";
}

<h1>Ürünlerim</h1>

<a asp-action="Create" class="btn btn-success mb-3">Yeni Ürün Ekle</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>CategoryId</th>
            <th>Enabled</th>
            <th>İşlemler</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.StockAmount</td>
                <td>@p.CategoryId</td>
                <td>@p.Enabled</td>
                <td>
                    <a asp-action="EditPrice" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Fiyat</a>
                    <a asp-action="EditStock" asp-route-id="@p.Id" class="btn btn-sm btn-info ms-2">Stok</a>
                </td>

            </tr>
        }
    </tbody>
</table>
