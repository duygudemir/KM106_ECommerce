@model App.Data.Entities.Product

@{
    ViewData["Title"] = "Ürün Detay";
    var comments = ViewBag.Comments as List<App.Data.Entities.ProductComment> ?? new();
}

<div class="row">
    <div class="col-md-8">

        <div class="card mb-3">
            <div class="card-header">
                <h3 class="mb-0">@Model.Name</h3>
            </div>

            <div class="card-body">
                <p class="mb-2">
                    <strong>Fiyat:</strong> @Model.Price
                </p>

                <p class="mb-2">
                    <strong>Kategori:</strong>
                    @(Model.Category != null ? Model.Category.Name : "-")
                </p>

                <p class="mb-3">
                    <strong>Satıcı:</strong>
                    @(Model.Seller != null ? (Model.Seller.FirstName + " " + Model.Seller.LastName) : "-")
                </p>

                <hr />

                <h5>Ürün Açıklaması</h5>

                @if (!string.IsNullOrWhiteSpace(Model.Details))
                {
                    <p class="mb-0">@Model.Details</p>
                }
                else
                {
                    <div class="text-muted">Bu ürün için açıklama girilmemiş.</div>
                }
            </div>
        </div>

        <a class="btn btn-secondary" asp-controller="Product" asp-action="Index">← Geri</a>

    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <strong>Yorumlar (@comments.Count)</strong>
            </div>

            <div class="card-body">

                @if (!comments.Any())
                {
                    <div class="text-muted">Henüz yorum yok.</div>
                }
                else
                {
                    @foreach (var c in comments)
                    {
                        <div class="border rounded p-2 mb-2">
                            <div class="small text-muted">
                                @(c.User != null ? (c.User.FirstName + " " + c.User.LastName) : "Kullanıcı")
                            </div>

                            <div class="small text-warning mb-1">
                                Puan: @c.StarCount / 5
                            </div>

                            <div>@c.Text</div>
                        </div>
                    }
                }

                <hr />

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("buyer"))
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <strong>Yeni Yorum Ekle</strong>
                        </div>

                        <div class="card-body">
                            <form asp-controller="Product" asp-action="Comment" method="post">
                                <input type="hidden" name="ProductId" value="@Model.Id" />

                                <div class="mb-2">
                                    <label class="form-label">Puan</label>
                                    <select name="StarCount" class="form-select">
                                        <option value="5">5 - Harika</option>
                                        <option value="4">4 - İyi</option>
                                        <option value="3">3 - Orta</option>
                                        <option value="2">2 - Kötü</option>
                                        <option value="1">1 - Çok Kötü</option>
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Yorum</label>
                                    <textarea name="Text" class="form-control" rows="3" placeholder="Yorumuz onaylandığında yayınlanacaktır."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    Gönder
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">
                        Yorum yazmak için buyer olarak giriş yapmalısın.
                    </div>
                }

            </div>
        </div>
    </div>
</div>
