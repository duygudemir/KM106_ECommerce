@model App.Data.Entities.Category

@{
    ViewData["Title"] = "Kategori Sil";
}

<h1>Kategori Sil</h1>

<div class="alert alert-warning">
    <strong>Dikkat:</strong> Bu kategoriyi silmek üzeresin. Emin misin?
</div>

<ul>
    <li><strong>Id:</strong> @Model.Id</li>
    <li><strong>Ad:</strong> @Model.Name</li>
    <li><strong>Color:</strong> #@Model.Color</li>
    <li><strong>Icon:</strong> @Model.IconCssClass</li>
</ul>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="List" class="btn btn-secondary">Vazgeç</a>
</form>
