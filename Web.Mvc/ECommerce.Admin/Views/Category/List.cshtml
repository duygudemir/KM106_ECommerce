@model List<App.Data.Entities.Category>

@{
    ViewData["Title"] = "Kategori Listesi";
}

<h1>Kategori Listesi</h1>

<a asp-action="Create" class="btn btn-success mb-3">Yeni Kategori</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Color</th>
            <th>Icon</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>

                <td>
                    <span style="display:inline-block;width:18px;height:18px;background:#@c.Color;border:1px solid #ccc;border-radius:4px;"></span>
                    #@c.Color
                </td>

                <td>@c.IconCssClass</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@c.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
