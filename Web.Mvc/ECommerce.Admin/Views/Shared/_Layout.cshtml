<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerce.Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerce.Admin.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Admin Panel</a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">Products</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="User" asp-action="List">Users</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Category" asp-action="List">Categories</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Comment" asp-action="List">Comments</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link text-light">
                            @User.Identity.Name
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Account" asp-action="Logout">
                            Logout
                        </a>
                    </li>
                }
            </ul>


        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
