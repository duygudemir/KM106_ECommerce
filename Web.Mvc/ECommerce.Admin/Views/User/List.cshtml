@model List<App.Data.Entities.User>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
}

<h1>Kullanıcı Listesi</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad Soyad</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Enabled</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.FirstName @u.LastName</td>
                <td>@u.Email</td>
                <td>@(u.Role != null ? u.Role.Name : "-")</td>
                <td>
                    @if (u.Enabled)
                    {
                        <span class="badge bg-success">True</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">False</span>
                    }
                </td>
                <td>
                    @if (!u.Enabled)
                    {
                        <a asp-action="Approve"
                           asp-route-id="@u.Id"
                           class="btn btn-sm btn-primary">
                            Approve
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Onaylı</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
