@model App.Data.Entities.ProductComment

@{
    ViewData["Title"] = "Yorum Onayla";
}

<h1>Yorum Onayla</h1>

<div class="alert alert-info">
    Bu yorumu onaylamak üzeresin. Emin misin?
</div>

<ul>
    <li><strong>Ürün:</strong> @(Model.Product != null ? Model.Product.Name : "-")</li>
    <li><strong>Kullanıcı:</strong> @(Model.User != null ? Model.User.FirstName + " " + Model.User.LastName : "-")</li>
    <li><strong>Yıldız:</strong> @Model.StarCount</li>
    <li><strong>Yorum:</strong> @Model.Text</li>
</ul>

<form asp-action="ApproveConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-primary">Evet, Onayla</button>
    <a asp-action="List" class="btn btn-secondary">Vazgeç</a>
</form>
