@model List<App.Data.Entities.Product>

@{
    ViewData["Title"] = "Products";
}

<h2 class="mb-3">Ürünler</h2>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>Kategori</th>
            <th>Satıcı</th>
            <th>Durum</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.StockAmount</td>
                <td>@(p.Category != null ? p.Category.Name : "-")</td>
                <td>@(p.Seller != null ? (p.Seller.FirstName + " " + p.Seller.LastName) : "-")</td>
                <td>
                    @if (p.Enabled)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td class="text-end">

                    <form asp-controller="Product" asp-action="Toggle" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@p.Id" />
                        @if (p.Enabled)
                        {
                            <button class="btn btn-sm btn-warning">Pasif Yap</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success">Aktif Yap</button>
                        }
                    </form>

                    <form asp-controller="Product" asp-action="Delete" method="post" class="d-inline"
                          onsubmit="return confirm('Bu ürünü silmek istediğine emin misin?');">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button class="btn btn-sm btn-danger">Sil</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
